    "config/contracts/core-loop-contract.json": {
      "executionClass": "execution_eligible",
      "foundational": true,
      "kind": "rule",
      "lifecycle": {
        "changedAt": "2026-11-10T12:05:13.346Z",
        "lastTransitionId": "intent-to-delivery-20261110:reviewed-core-loop",
        "reason": "Reviewed current full contract and parsed semantic diff from registered bytes. Only projectResearchPolicy, taskProgressPolicy and crossRuntimeBoundary.targets differ. Research retains existing intent/PRD authority; task progress has mutationAuthority none, preserves unrelated work and unknown outcome states; Gemini/ZCode join the format boundary without broadening the codex/claude P-117 execution evidence or claiming live verification. Eight-stage order, merge barriers, permission and writeback rules remain unchanged."
      },
      "provenance": {
