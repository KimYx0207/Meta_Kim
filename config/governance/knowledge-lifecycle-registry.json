  "entries": {
    "canonical/skills/meta-theory/SKILL.md": {
      "executionClass": "execution_eligible",
      "foundational": true,
      "kind": "knowledge",
      "lifecycle": {
        "changedAt": "2026-11-10T13:09:02.004Z",
        "lastTransitionId": "intent-to-delivery-20261110:reviewed-scoped-human-gates",
        "reason": "Reviewed all five changed source lines against the exact revision-8 registered body and current implementation. Desktop overlap requires the existing current graph, exact graph and attempt-definition binding, unrelated ancestry and supported read-only effects; CLI forwards that same optional graph. Missing evidence keeps the human gate pending and no graph input grants execution permission. Capability discovery starts with bounded first-party cached-index search; findskill is used only when installed and appropriate, with no default full scan or external request. All other source bytes match the previously reviewed source."
      },
