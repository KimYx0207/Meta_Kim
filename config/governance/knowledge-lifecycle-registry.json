    "config/governance/decision-pattern-catalog.json": {
      "executionClass": "reference_only",
      "foundational": false,
      "kind": "capability_index",
      "lifecycle": {
        "changedAt": "2026-11-10T13:15:56.623Z",
        "lastTransitionId": "intent-to-delivery-20261110:reviewed-absorbed-decision-methods",
        "reason": "Independently reviewed the complete parsed delta against the exact registered Git source. Five attributed reference entries and three bounded stage methods absorb core-problem framing, evidence labeling, sufficient local discovery, native work-order boundaries and specification-before-quality review. Five existing patterns gain source references only. Prior pattern behavior, prior sources and the reference-only/not-invokable source boundary are unchanged. Four Kim_Service source-byte hashes and their local LICENSE/NOTICE files were checked; official Superpowers README and MIT license confirm the limited review concepts. Local absence smoke and packet preparation pass without optional workflow packages. This binds reference knowledge only, not provider execution, a second scheduler, action approval or live-host certification."
      },
      "provenance": {
        "evidenceRefs": [
