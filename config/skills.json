{
  "$schema": "./contracts/skills-manifest.schema.json",
  "schemaVersion": 1,
  "skillOwner": "KimYx0207",
  "skills": [
    {
      "id": "agent-teams-playbook",
      "repo": "${skillOwner}/Kim_Service",
      "installMethod": "subdirExtraction",
      "targets": [
        "claude",
        "codex",
        "openclaw",
        "cursor"
      ],
      "subdir": "skills/agent-teams-playbook"
    },
    {
      "id": "findskill",
      "repo": "${skillOwner}/Kim_Service",
      "installMethod": "subdirExtraction",
      "legacyNames": [
        "find-skills"
      ],
      "targets": [
        "claude",
        "codex",
        "openclaw",
        "cursor"
      ],
      "subdir": "skills/find-skill"
    },
    {
      "id": "hookprompt",
      "repo": "${skillOwner}/Kim_Service",
      "installMethod": "subdirExtraction",
      "capabilities": [
        "prompt-submission-optimization"
      ],
      "platformSupport": {
        "claude": {
          "status": "native",
          "events": [
            "UserPromptSubmit"
          ],
          "adapter": "claude-settings-hook"
        },
        "codex": {
          "status": "adapter-required",
          "events": [
            "UserPromptSubmit"
          ],
          "adapter": "codex-hookprompt-adapter"
        },
        "openclaw": {
          "status": "degraded",
          "events": [
            "command:new"
          ],
          "adapter": "openclaw-workspace-instruction"
        },
        "cursor": {
          "status": "adapter-required",
          "events": [
            "beforeSubmitPrompt"
          ],
          "adapter": "cursor-hookprompt-adapter"
        }
      },
      "fallback": {
        "openclaw": "Use workspace boot and agent instructions; no direct Claude hook execution.",
        "cursor": "Use Cursor beforeSubmitPrompt through the Meta_Kim adapter; do not reuse Claude hook output directly."
      },
      "globalHookSubdirs": {
        "claude": [
          "~/.claude/hooks/meta-kim"
        ]
      },
      "hookExtraFiles": {
        "claude": [
          {
            "src": "hooks/hookprompt/.claude/prompt-optimizer-meta.md",
            "dest": "prompt-optimizer-meta.md"
          }
        ]
      },
      "hookSettingsMerge": {
        "claude": {
          "event": "UserPromptSubmit",
          "hookFile": "user-prompt-submit.js",
          "timeout": 60
        }
      },
      "targets": [
        "claude",
        "codex",
        "cursor"
      ],
      "subdir": "hooks/hookprompt",
      "hookSubdirs": {
        "claude": [
          "hooks/hookprompt/.claude/hooks"
        ]
      }
    },
    {
      "id": "superpowers",
      "repo": "obra/superpowers",
      "claudePlugin": "superpowers@superpowers-marketplace",
      "codexPlugin": "superpowers",
      "cursorPlugin": "superpowers",
      "marketplace": {
        "id": "superpowers-marketplace",
        "repository": "obra/superpowers-marketplace"
      },
      "versionSource": {
        "provider": "github-contents",
        "repository": "obra/superpowers",
        "manifestPath": ".claude-plugin/marketplace.json",
        "pluginName": "superpowers"
      },
      "installMethod": "pluginMarketplace",
      "fallbackContentDir": "skills",
      "targets": [
        "claude",
        "codex",
        "openclaw",
        "cursor",
        "opencode"
      ]
    },
