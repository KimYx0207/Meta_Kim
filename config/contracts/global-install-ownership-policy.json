{
  "schemaVersion": "meta-kim-global-install-ownership-policy-v1",
  "durableRuntimeBundle": {
    "runtime": "claude",
    "assetType": "mcp",
    "category": "C",
    "sourceOwner": "sync-global-meta-theory",
    "purpose": "claude-global-mcp-runtime-bundle"
  },
  "projectionPackageStore": {
