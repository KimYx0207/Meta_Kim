        "lifecycle_origin_disappearance",
        "accidental_first_party_drift",
        "transient_package_cache_deletion"
      ],
      "doesNotClaim": [
        "same_user_malicious_concurrency_resistance",
        "supply_chain_compromise_resistance"
      ]
    }
  },
  "externalEntries": [
    {
      "runtime": "codex",
      "assetType": "hooks",
      "category": "B",
      "sourceOwner": "sync-global-meta-theory",
      "purpose": "codex-global-hookprompt-adapter",
      "kinds": ["file"],
      "base": "runtimeHomeParent",
      "path": ".codex/hooks/hookprompt-adapter.mjs",
      "match": "exact"
    },
    {
      "runtime": "claude",
      "assetType": "mcp",
      "category": "C",
      "sourceOwner": "sync-global-meta-theory",
      "purpose": "claude-global-mcp",
      "kinds": ["mcp-server"],
      "base": "runtimeHomeParent",
      "path": ".claude.json",
      "match": "exact"
    }
  ]
