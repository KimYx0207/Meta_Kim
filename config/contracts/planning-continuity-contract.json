{
  "schemaVersion": "1.0.0",
  "id": "meta-kim-planning-continuity",
  "owner": "meta-conductor",
  "reviewOwners": [
    "meta-sentinel",
    "meta-prism"
  ],
  "purpose": "Keep governed planning resumable without requiring an external planning skill, script, hook bundle, cache, or network lookup.",
  "humanReadableFiles": [
    "task_plan.md",
    "findings.md",
    "progress.md"
  ],
  "authority": {
    "root": ".meta-kim/state/{profile}/planning-continuity",
    "binding": [
      "trusted_project_root",
      "runtime",
      "run_identifier_digest"
    ],
    "writer": "meta-conductor_or_main_coordinator",
    "atomicity": "file_lock_plus_temp_rename",
    "ledger": "bounded_structured_events"
  },
  "initialization": {
    "trigger": "governed_route_active_or_explicit_cli",
    "mode": "create_missing_only",
    "overwriteExisting": false,
    "existingFilesRequireOwnerReviewBeforeAttestation": true
  },
  "recovery": {
    "requiresCurrentAttestation": true,
    "rejectsProjectOrRunMismatch": true,
    "rejectsSymlinkEscape": true,
    "rejectsHashDrift": true,
    "rejectsControlInstructionPatterns": true,
    "implicitPlanRoot": "reuse_only_exact_project_runtime_run_authority",
    "explicitPlanRootConflict": "refuse_without_rebinding",
    "missingSavedPlanRoot": "refuse_without_recreating",
    "crossWorktreeInference": false,
    "projectionBinding": ["projectRoot", "planRoot", "runtime", "runKey"],
    "progressProjection": "latest_bounded_structural_status_and_next_action_not_execution_evidence",
    "autoInjectedFiles": [
      "task_plan.md",
      "progress.md"
    ],
    "neverAutoInjectedFiles": [
      "findings.md"
    ],
    "projection": "bounded_structural_summary"
  },
  "diagnosticOutput": {
    "cliSchema": "meta-kim-planning-cli-v1",
    "default": "bounded_summary_with_full_data_counts_file_references_and_explicit_omissions",
    "originalFiles": "preserved_without_rewriting_or_truncation",
    "libraryApi": "retains_complete_records_and_completion_checklists",
    "completionDecision": "always_evaluated_against_complete_source_before_projection",
    "stopLedger": "completion_facts_and_checklist_counts_without_repeated_checklist_text",
    "limitsAuthority": "canonical/runtime-assets/shared/hooks/planning-continuity.mjs:CONTEXT_LIMITS",
    "configuration": {
      "environment": "META_KIM_PLANNING_CONTEXT_LIMITS",
      "cli": "--context-limits",
      "libraryOption": "contextLimits",
      "format": "JSON_object_with_validated_integer_ranges",
      "precedence": ["defaults", "environment", "explicit_option"]
    },
    "explicitReading": {
      "command": "read --file <planning-file> --offset <utf16-offset> --length <bounded-length> --sha256 <source-hash>",
      "allowedFilesRef": "humanReadableFiles",
      "continuation": "nextRead_returns_exact_source_hash_and_unicode_safe_next_offset",
      "subsequentPageRequiresHash": true,
      "changedSource": "refuse_continuation_without_renewing_attestation",
      "byteBudgetExceeded": "refuse_page_with_actionable_smaller_length_instead_of_silent_truncation"
    },
    "guide": "docs/harness-architecture.md#bounded-planning-diagnostics"
  },
  "completionGate": {
    "lifecycleTrigger": "affirmative_completion_claim_in_current_last_assistant_message",
    "lifecycleDetection": "conservative_text_recognition_is_scheduling_not_completion_evidence",
    "ordinaryTurnYield": {
      "decision": "silent_allow_without_completion_claim",
      "includes": [
        "clarification",
        "waiting_for_user",
        "progress",
        "missing_or_malformed_current_message"
      ],
      "changesPlanningAuthority": false,
      "consumesOrResetsBlockingAttempts": false
    },
    "explicitCliAndLibraryStop": "always_evaluate_completion_conditions",
    "requires": [
      "current_attestation",
      "no_open_checklist_items",
      "verification_passed",
      "summary_closed"
    ],
    "zeroPhase": "explicit_reason_required",
    "maxBlockingAttempts": 2,
    "afterBound": "allow_stop_without_completion_claim"
  },
  "runtimeSupport": {
    "claude_code": {
      "target": "lifecycle_block",
      "claimUntilVerified": "adapter_unverified"
    },
    "codex": {
      "target": "lifecycle_block",
      "claimUntilVerified": "adapter_unverified"
    },
    "cursor": {
      "target": "no_adapter",
      "claimUntilVerified": "blocked"
    },
    "openclaw": {
      "target": "no_adapter",
      "claimUntilVerified": "blocked"
    }
  },
  "dependencyPolicy": {
    "implementationAuthority": "meta_kim_first_party",
    "externalReference": "OthmanAdi/planning-with-files",
    "externalReferenceStatus": "retain_until_absence_test_and_independent_review",
    "deletionRequiresUserAuthorization": true
  },
  "absenceAcceptance": {
    "networkFallbackAbsent": true,
    "hostOsEvidenceOnly": true,
    "externalCheckoutAbsent": true,
    "runtimeSkillCopiesAbsent": true,
    "externalHookBundleAbsent": true,
    "cacheFallbackAbsent": true,
    "requiredScenarios": [
      "fresh_init",
      "existing_file_preservation",
      "session_resume",
      "run_isolation",
      "tamper_refusal",
      "structured_ledger",
      "doctor",
      "bounded_completion_gate"
    ]
  }
}
