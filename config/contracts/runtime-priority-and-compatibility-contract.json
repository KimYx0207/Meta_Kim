{
  "schemaVersion": "runtime-priority-and-compatibility-contract-v0.1",
  "contractId": "runtime-priority-and-compatibility-contract",
  "owner": "meta-conductor",
  "reviewOwner": "meta-prism",
  "verificationOwner": "verify",
  "prdTaskIds": ["P-085", "P-092"],
  "status": "productized",
  "currentAsOf": "2026-08-21",
  "purpose": "Make Claude Code and Codex the primary prompt-first full-flow runtimes, keep ZCode, DeepSeek Harness, Qoder CLI, and Trae as opt-in beta compatibility adapters, and preserve OpenClaw and Cursor as compatibility runtimes without allowing lower tiers to overclaim or block a higher tier.",
  "primaryRuntimeTier": ["claude_code", "codex"],
  "betaCompatibilityRuntimeTier": ["zcode", "deepseek-harness", "qoder", "trae"],
  "compatibilityRuntimeTier": ["openclaw", "cursor"],
  "priorityOrder": ["primary", "beta_compatibility", "compatibility"],
  "primaryRequiredEvidenceKind": "runtime_live_pass",
  "compatibilityAllowedEvidenceKinds": [
    "compatibility_smoke_pass",
    "projection_smoke",
    "blocked_with_contract",
    "native_harness_missing",
    "candidate_probe",
    "packed_structural_adapter",
    "degraded"
  ],
  "betaCompatibilityAllowedEvidenceKinds": ["packed_structural_adapter"],
  "priorityRules": {
    "sameFrameworkPromptRequiredForPrimary": true,
    "primaryClosureTasks": ["P-087", "P-088", "P-089", "P-090", "P-091"],
    "primaryBlockers": [
      "missing claude_code runtime_live_pass",
      "missing codex runtime_live_pass",
      "parity failure",
      "prompt perfection failure",
      "evidence overclaim"
    ],
    "compatibilityDoesNotBlockPrimary": true,
    "betaCompatibilityDoesNotBlockPrimary": true,
    "compatibilityDoesNotBlockBetaCompatibility": true,
    "cursorNativeLiveBlockedOnlyBlocksAllToolCompatibility": true,
    "p024BlocksOnly": "all-tool compatibility claim",
    "compatibilityPriorityLeakTarget": 0,
    "betaCompatibilityPriorityLeakTarget": 0,
    "openclawCursorPrimaryBlockerTarget": 0
  },
  "compatibilityDemotion": {
    "zcode": {
      "tier": "beta_compatibility",
      "keptEvidence": ["packed_structural_adapter", "plan_only", "blocked_with_reason"],
      "notAllowedToBlock": ["Claude Code primary release gate", "Codex primary release gate"],
      "notAllowedClaims": ["formal projection", "native runtime", "live certification", "default sync target"]
    },
    "deepseek-harness": {
      "tier": "beta_compatibility",
      "keptEvidence": ["packed_structural_adapter", "developer_preview", "ACP automation seam", "blocked_with_reason"],
      "notAllowedToBlock": ["Claude Code primary release gate", "Codex primary release gate"],
      "notAllowedClaims": ["formal projection", "native runtime", "complete UI", "live certification", "default sync target"]
    },
    "qoder": {
      "tier": "beta_compatibility",
      "keptEvidence": ["packed_structural_adapter", "official_rules_skills_agents_commands_hooks_mcp", "blocked_with_reason"],
      "notAllowedToBlock": ["Claude Code primary release gate", "Codex primary release gate"],
      "notAllowedClaims": ["formal projection", "native runtime", "live certification", "default sync target"]
    },
    "trae": {
      "tier": "beta_compatibility",
      "keptEvidence": ["packed_structural_adapter", "official_rules_skills_agents_mcp", "blocked_with_reason"],
      "notAllowedToBlock": ["Claude Code primary release gate", "Codex primary release gate"],
      "notAllowedClaims": ["formal projection", "native runtime", "live certification", "default sync target"]
    },
    "openclaw": {
      "tier": "compatibility",
      "keptEvidence": ["projection", "shard", "smoke", "batch_stability", "blocked_with_reason"],
      "notAllowedToBlock": ["Claude Code primary release gate", "Codex primary release gate"]
    },
    "cursor": {
      "tier": "compatibility",
      "keptEvidence": ["smoke", "native_harness_blocked", "WSL candidate probe", "remainingAction"],
      "notAllowedToBlock": ["Claude Code primary release gate", "Codex primary release gate"],
      "remainingAction": "Install or expose a parseable Cursor Agent CLI before upgrading P-024 to native live pass."
    }
  },
  "noOverclaimRules": [
    "ZCode, DeepSeek Harness, Qoder CLI, and Trae beta adapters prove only a packed structural adapter; they are not live-certified or native runtime support.",
    "Beta compatibility adapters are opt-in, disabled by default, absent from sync supportedTargets, and cannot start a process, invoke a model, consume quota, or write global or user configuration.",
    "DeepSeek Harness ACP is an automation structural seam only and cannot be presented as a complete Harness UI or runtime.",
    "OpenClaw or Cursor smoke cannot be renamed primary live pass.",
    "A blocked Cursor native live harness cannot be renamed release-grade pass.",
    "A primary Claude Code or Codex pass cannot be broadened into Claude/Codex/Cursor/OpenClaw all-tool compatibility completion.",
    "P-024 and P-025 remain explicit external-environment blockers until native Cursor Agent CLI evidence exists."
  ],
  "crossContractConsistency": [
    "config/contracts/prompt-first-full-flow-stage-contract.json",
    "config/contracts/prompt-first-live-acceptance-contract.json"
  ],
  "verificationCommand": "npm run meta:prd:runtime-priority:validate"
}
