{
  "agents": {
    "list": [
      {
        "id": "meta-warden",
        "default": true,
        "name": "Meta-Warden: Meta Department Manager",
        "workspace": "__REPO_ROOT__/openclaw/workspaces/meta-warden"
      },
      {
        "id": "meta-genesis",
        "default": false,
        "name": "Meta-Genesis: Soul Meta 🧬",
        "workspace": "__REPO_ROOT__/openclaw/workspaces/meta-genesis"
      },
      {
        "id": "meta-artisan",
        "default": false,
        "name": "Meta-Artisan: Craft Meta 🎨",
        "workspace": "__REPO_ROOT__/openclaw/workspaces/meta-artisan"
      },
      {
        "id": "meta-sentinel",
        "default": false,
        "name": "Meta-Sentinel: Sentinel Meta",
        "workspace": "__REPO_ROOT__/openclaw/workspaces/meta-sentinel"
      },
      {
        "id": "meta-librarian",
        "default": false,
        "name": "Meta-Librarian: Archive Meta",
        "workspace": "__REPO_ROOT__/openclaw/workspaces/meta-librarian"
      },
      {
        "id": "meta-conductor",
        "default": false,
        "name": "Meta-Conductor: Orchestration Meta",
        "workspace": "__REPO_ROOT__/openclaw/workspaces/meta-conductor"
      },
      {
        "id": "meta-prism",
        "default": false,
        "name": "Meta-Prism: Iterative Reviewer",
        "workspace": "__REPO_ROOT__/openclaw/workspaces/meta-prism"
      },
      {
        "id": "meta-scout",
        "default": false,
        "name": "Meta-Scout: Tool Discoverer 🔭",
        "workspace": "__REPO_ROOT__/openclaw/workspaces/meta-scout"
      },
      {
        "id": "meta-chrysalis",
        "default": false,
        "name": "Meta-Chrysalis: Evolution Meta (cididian)",
        "workspace": "__REPO_ROOT__/openclaw/workspaces/meta-chrysalis"
      }
    ]
  },
  "bindings": [],
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "session-memory": {
          "enabled": true
        },
        "command-logger": {
          "enabled": true
        },
        "boot-md": {
          "enabled": true
        },
        "continuation-save-progress": {
          "enabled": true,
          "description": "Writes a continuationRequired flag into the project's .claude/project-task-state.json when the assistant announces an unfinished handoff after visible progress. Cwd-scoped to the selected project directory.",
          "command": "node __REPO_ROOT__/openclaw/hooks/stop-save-progress.mjs"
        }
      }
    }
  },
  "skills": {
    "load": {
      "extraDirs": ["__REPO_ROOT__/openclaw/skills"]
    }
  },
  "tools": {
    "agentToAgent": {
      "enabled": true,
      "allow": [
        "meta-warden",
        "meta-genesis",
        "meta-artisan",
        "meta-sentinel",
        "meta-librarian",
        "meta-conductor",
        "meta-prism",
        "meta-scout",
        "meta-chrysalis"
      ]
    }
  },
  "mcp": {
    "servers": {
      "meta-kim-runtime": {
        "command": "node",
        "args": ["__REPO_ROOT__/scripts/mcp/meta-runtime-server.mjs"],
        "env": {
          "META_KIM_RUNTIME_FAMILY": "openclaw"
        }
      }
    }
  }
}
